# Runtime-only image for altisly-website.
# Nuxt is built on the CI runner; .output/ is synced into build-output/ before this runs.
FROM node:22-slim

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3300
ENV HOST=0.0.0.0
ENV NITRO_PORT=3300
ENV NITRO_HOST=0.0.0.0

COPY build-output/output/ ./

RUN mkdir -p /app/data

EXPOSE 3300

CMD ["node", "server/index.mjs"]
